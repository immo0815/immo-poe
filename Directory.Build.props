<Project>

  <!--
    Shared settings for every project in the solution. Change something here and it
    applies everywhere - there is deliberately no per-project duplication of these.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Lets the Windows-only projects build on a Linux CI / dev container. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Native AOT needs trim-safe code; surfacing the analyzers now avoids a
         painful retrofit later. See docs/architecture.md "Deployment". -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <!--
    THE SIX LABORS LICENSE. ImageSharp 3.2.0 and later refuse to build anything but Debug without
    a license key (SixLabors.Licensing's ValidateLicenseTask, run before CoreCompile in every project
    referencing the package directly). sixlabors.lic beside this file is a free COMMUNITY license
    for open-source projects, scoped to the three assemblies that reference ImageSharp -
    ClickableTransparentOverlay, PoEformance.Overlay and IconBaker - which Six Labors allows to be
    committed to a public repository. Named here because the package only looks for the file under
    each project's own folder. It runs out on 2028-01-25 (its ExpiryDateUtc); a new one comes from
    the same form at sixlabors.com, and an assembly added that references ImageSharp needs its name
    added to it.

    Before it (up to v0.1.304) the tool stayed on 3.1.12 and suppressed six advisories one by one,
    each checked not to reach it; 3.2.0 fixes all six.
  -->
  <PropertyGroup>
    <SixLaborsLicenseFile>$(MSBuildThisFileDirectory)sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>

</Project>
