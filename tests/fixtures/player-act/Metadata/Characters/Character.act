	// ADD MTX PORTAL TIMELINES ABOVE HERE
	
	stance Unarmed
	{
		Melee = Melee::simple;
		HeavyStun = "stagger_unarmed_01" timeline "Metadata/Characters/Timelines/base_unarmed/base_unarmed.atl";
		PalmStrike = Template::palm_strike replace SKILL "shattering_palm";
		Execute = Template::palm_strike replace SKILL "killing_palm";
		WindPalm = Template::palm_strike replace SKILL "wind_palm";
		HandOfChayula = Template::palm_strike replace SKILL "hand_of_chayula";

		//USED BY FACEBREAKER AND HOLLOW PALM
		Template::basic_power_attack =
		"
			attack_TYPE_01SUFFIX
				: min_duration = 0.75,
			attack_TYPE_02SUFFIX
				: max_duration = 0.75
				: min_duration = 0.6,
			attack_TYPE_03SUFFIX
				: max_duration = 0.6
				: min_duration = 0.45,
			attack_TYPE_04SUFFIX
				: max_duration = 0.45
				: min_duration = 0.35,
			attack_TYPE_05SUFFIX
				: max_duration = 0.35
		" timeline "Metadata/Characters/Timelines/base_unarmed/base_unarmed.atl" tag MeleeDualAlternating;

		//ALL ANIMATIONS IN THIS STANCE SHOULD BE ADDED ABOVE HERE
		with_tag Base timeline "Metadata/Characters/Timelines/base_unarmed/base_unarmed.atl";

		//SKILL HAND USE OVERRIDES FOR VFX
		with_tag channel_forward with_visual_off_hand;
		with_tag channel_projectile with_visual_off_hand;
		with_tag command with_visual_off_hand;
		with_tag mark with_visual_off_hand;
		with_tag spell_nova with_visual_off_hand;
		with_tag spell_summon with_visual_both_hands;
		with_tag spell_sweep with_visual_off_hand;
		with_tag throw_flask with_visual_main_hand;

		stance UnarmedTown
		{
			with_tag Idle::town;

			stance TalismanTown { }
		}

		stance Talisman { }

		stance Facebreaker
		{
			Idle = "idle_facebreaker_unarmed_01" timeline "Metadata/Characters/Timelines/base_unarmed/base_unarmed.atl";
			PersistentIdleFemale = "idle_facebreaker_unarmed_01_female" timeline "Metadata/Characters/Timelines/base_unarmed/base_unarmed.atl";

			Melee = Template::basic_power_attack replace TYPE "unarmed" replace SUFFIX "a" start_pose_right_melee end_pose_left_melee; then Template::basic_power_attack replace TYPE "unarmed" replace SUFFIX "b" start_pose_left_melee end_pose_right_melee;

			LeapSlam = "leapslam_unarmed_01_far" timeline "Metadata/Characters/Timelines/mace_leap_slam/leap_slam.atl" start_pose_right_low end_pose_right_low ;
			LeapSlamMoving = "leapslam_unarmed_01_moving" timeline "Metadata/Characters/Timelines/mace_leap_slam/leap_slam.atl" start_pose_right_low end_pose_right_low ;
			LeapSlamNear = "leapslam_unarmed_01_near" timeline "Metadata/Characters/Timelines/mace_leap_slam/leap_slam.atl" start_pose_right_low end_pose_right_low ;

			PerfectStrike =  "perfect_strike_loop_unarmed_01" timeline "Metadata/Characters/Timelines/mace_perfect_strike/perfect_strike.atl";
			PerfectStrikeEnd = "perfect_strike_end_normal_unarmed_01" timeline "Metadata/Characters/Timelines/mace_perfect_strike/perfect_strike.atl";
			PerfectStrikePerfectEnd = "perfect_strike_end_perfect_unarmed_01" timeline "Metadata/Characters/Timelines/mace_perfect_strike/perfect_strike.atl";

			ArmourBreaker = Template::armour_breaker;

			Boneshatter = Template::boneshatter replace SUFFIX "";
			BoneshatterMoving = Template::boneshatter replace SUFFIX "_moving";

			Earthquake = Template::earthquake;

			GroundSlam = Template::ground_slam;

			VolcanicFissure = Template::volcanic_fissure;

			MoltenSlam = Template::molten_slam;

			DoubleSlam = Template::rolling_slam replace SUFFIX "";
			DoubleSlamMoving = Template::rolling_slam replace SUFFIX "_moving";
			DoubleSlamMovingNear = Template::rolling_slam replace SUFFIX "_step";

			Sunder = Template::sunder replace SUFFIX "" moving_animation SunderMoving;
			SunderMoving = Template::sunder replace SUFFIX "_moving";

			MoltenBlast = Template::moltenblast replace ANIM "";
			MoltenBlastBackward = Template::moltenblast replace ANIM "_backward";
				
			HammerOfTheGods = Template::hammer_of_the_gods;

			ForgeHammer = Template::forge_hammer;
			ForgeHammerRecall = Template::forge_hammer_recall;

			StampedeStart = Template::stampede replace ANIM "start";
			Stampede = Template::stampede replace ANIM "loop";
			StampedeEnd = Template::stampede replace ANIM "end";
			StampedeStartMoving = "@StampedeStart";

			stance FacebreakerTown { }
		}

		stance HollowPalm
		{
			Idle = "idle_hollow_palm_01" timeline "Metadata/Characters/Timelines/base_unarmed/base_unarmed.atl";
			PersistentIdleFemale = "idle_hollow_palm_01_female" timeline "Metadata/Characters/Timelines/base_unarmed/base_unarmed.atl";
			WeaponSwap = "weapon_swap_hollowpalm_01" timeline "Metadata/Characters/Timelines/base_unarmed/base_unarmed.atl";

			Melee = Template::basic_power_attack replace TYPE "hollowpalm" replace SUFFIX "a" start_pose_right_melee end_pose_left_melee; then Template::basic_power_attack replace TYPE "hollowpalm" replace SUFFIX "b" start_pose_left_melee end_pose_right_melee;

			LightningStrike 			= Template::lightning_strike replace SKILL "lightningstrike" replace ANIM "_smallmove";
			LightningStrikeStationary 	= Template::lightning_strike replace SKILL "lightningstrike" replace ANIM "_stationary";
			LightningStrikeMoving 		= Template::lightning_strike replace SKILL "lightningstrike" replace ANIM "_move";
			TempestBellSlam 			= Template::lightning_strike replace SKILL "tempestbell" replace ANIM "_moving";
			TempestBellSlamStationary 	= Template::lightning_strike replace SKILL "tempestbell" replace ANIM "";

			GlacialCascade  = Template::staff_ranged_attack replace SKILL "glacial_cascade";
			StormWave 		= Template::staff_ranged_attack replace SKILL "storm_wave";

			WhirlingAssault 		= Template::double_spin replace SKILL "whirling_assault" replace ANIM "" moving_animation WhirlingAssaultMoving;
			WhirlingAssaultMoving	= Template::double_spin replace SKILL "whirling_assault" replace ANIM "_moving";

			GaleStrike = Template::gale_strike replace SKILL "gale_strike";

			GatheringStorm = Template::charged_dash replace SKILL "charged_dash" replace ANIM "start";
			GatheringStormEnd = Template::charged_dash replace SKILL "charged_dash" replace ANIM "end";
			GatheringStormPerfectEnd = Template::charged_dash replace SKILL "charged_dash" replace ANIM "end_perfect";

			ComboAttack = Template::combo_staff replace SKILL "combo" replace ANIM "";
			ComboAttackMoving = Template::combo_staff replace SKILL "combo" replace ANIM "_dash";

			FlickerStrikeFirst = "flicker_strike_unarmed_01a" timeline "Metadata/Characters/Timelines/flicker_strike/flicker_strike.atl"start_pose_right_melee end_pose_right_high ;
			FlickerStrikeFirstMoving = "flicker_strike_unarmed_01a_moving" timeline "Metadata/Characters/Timelines/flicker_strike/flicker_strike.atl"start_pose_right_melee end_pose_right_high ;
			
			FlickerStrike =
			"
				flicker_strike_unarmed_01b,
				flicker_strike_unarmed_01c,
				flicker_strike_unarmed_01d
			" timeline "Metadata/Characters/Timelines/flicker_strike/flicker_strike.atl";

			MantraOfDestruction = 
			"
				mantra_of_destruction_unarmed_01_stationary
				: visual_variants = power_stance_unarmed_01_moving
			"
			timeline "Metadata/Characters/Timelines/staff_power_stance/mantra_of_destruction.atl" base_layer_override FixedRun FixedRunLayerBase base_layer_override Idle IdleLayerBaseStatic fixed_run_muting FixedRunLayerNoTwist;
			
			FreezingBackflip = Template::evasive_strike replace SKILL "freezing_backflip";

			TempestFlurry = Template::tempest_flurry replace SKILL "tempest_flurry";
			TempestFlurryMoving = "@TempestFlurry";

			ChargeStaff =
			"
				charged_fist_01_stationary
				: visual_variants = charge_weapon_unarmed_01_moving
			" timeline "Metadata/Characters/Timelines/charge_weapon/charged_staff.atl" base_layer_override FixedRun FixedRunLayerBase base_layer_override Idle IdleLayerBaseStatic fixed_run_muting FixedRunLayerNoTwist;

			OrbOfIce = Template::ground_strike replace SKILL "frozen_locus";

			ChargedStrike			 	= Template::stealing_strike replace SKILL "stealing_strike" replace ANIM "dash";
			ChargedStrikeStationary 	= Template::stealing_strike replace SKILL "stealing_strike" replace ANIM "stationary";
			ChargedStrikeFlourish 		= Template::stealing_strike_flourish replace SKILL "stealing_strike";

			VaultingImpact 				= Template::staff_leap_slam replace SKILL "vaulting_impact" replace ANIM "";
			VaultingImpactMoving		= Template::staff_leap_slam replace SKILL "vaulting_impact" replace ANIM "_moving";
			VaultingImpactShort 		= Template::staff_leap_slam replace SKILL "vaulting_impact" replace ANIM "_near";
			VaultingImpactMovingShort 	= Template::staff_leap_slam replace SKILL "vaulting_impact" replace ANIM "_near_moving";

			CrushingFearStationary = "crushing_advance_unarmed_03" timeline "Metadata/Characters/Timelines/uniques/crushingfear/crushingfear.atl";
			//CrushingFear = "crushing_advance_unarmed_03_step" timeline "Metadata/Characters/Timelines/uniques/crushingfear/crushingfear.atl";
			CrushingFearNova = "crushing_advance_activate_unarmed_03" timeline "Metadata/Characters/Timelines/uniques/crushingfear/crushingfear.atl";

			stance HollowPalmTown { }
		}
	
